{
  "layer": "top",
  "position": "top",
  "height": 30,
  "modules-left": ["sway/workspaces", "sway/mode"],
  "modules-center": ["sway/window"],
  "modules-right": ["network", "cpu", "memory", "pulseaudio", "battery", "clock", "tray"],
  "clock": {"format": "{:%a %d %b  %H:%M}", "tooltip": true},
  "cpu": {"format": "CPU {usage}%"},
  "memory": {"format": "RAM {used:0.1f}G"},
  "network": {"format-wifi": "Wi-Fi {essid}", "format-ethernet": "LAN", "format-disconnected": "Offline"},
  "pulseaudio": {"format": "VOL {volume}%"},
  "battery": {"format": "BAT {capacity}%"}
}
